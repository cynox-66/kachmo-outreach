{
  "name": "kachmo-outreach-engine",
  "version": "1.0.0",
  "description": "Kachmo Studios cold outreach email dispatch and tracking engine",
  "type": "module",
  "scripts": {
    "send:titan": "tsx scripts/send-titan-smtp.ts",
    "send:test": "tsx scripts/send-titan-smtp.ts --test",
    "draft:titan": "tsx scripts/create-titan-drafts.ts",
    "dispatch:cron": "tsx scripts/cron-dispatch.ts",
    "dispatch:dry": "tsx scripts/cron-dispatch.ts --dry-run",
    "leads:migrate": "tsx scripts/migrate-csv-to-leads.ts",
    "leads:export-csv": "tsx scripts/leads-export-csv.ts",
    "leads:dedupe": "tsx scripts/leads-dedupe.ts",
    "leads:qualify": "tsx scripts/leads-qualify.ts",
    "leads:score": "tsx scripts/leads-score.ts",
    "leads:research-queue": "tsx scripts/leads-research-queue.ts",
    "leads:enrich": "tsx scripts/leads-enrich.ts",
    "leads:opportunity": "tsx scripts/leads-opportunity.ts",
    "leads:refresh": "tsx scripts/leads-refresh.ts",
    "leads:record": "tsx scripts/leads-record.ts",
    "queue:calls": "tsx scripts/queue-calls.ts",
    "queue:whatsapp": "tsx scripts/queue-whatsapp.ts",
    "calls:log": "tsx scripts/call-log.ts",
    "whatsapp:log": "tsx scripts/whatsapp-log.ts",
    "pipeline:log": "tsx scripts/pipeline-log.ts",
    "suppress:add": "tsx scripts/suppress-add.ts",
    "email:check-queue": "tsx scripts/email-queue-check.ts",
    "audit:baseline": "tsx scripts/audit-baseline.ts",
    "war-room": "tsx scripts/war-room.ts",
    "analytics:weekly": "tsx scripts/analytics-weekly.ts",
    "test": "tsx scripts/__tests__/run-tests.ts && tsx scripts/__tests__/golden-v1.ts && tsx scripts/__tests__/golden-write-paths.ts && tsx scripts/__tests__/titan-guard.ts && tsx scripts/__tests__/core-extraction.ts && tsx scripts/__tests__/reconciliation.ts",
    "test:legacy": "tsx scripts/__tests__/run-tests.ts",
    "test:golden": "tsx scripts/__tests__/golden-v1.ts",
    "test:titan": "tsx scripts/__tests__/titan-guard.ts",
    "typecheck": "tsc -p core/tsconfig.json && tsc -p scripts/tsconfig.json",
    "test:golden-writes": "tsx scripts/__tests__/golden-write-paths.ts",
    "test:core": "tsx scripts/__tests__/core-extraction.ts",
    "test:reconciliation": "tsx scripts/__tests__/reconciliation.ts"
  },
  "author": "Dev Jaiswal (Kachmo Studios)",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "dotenv": "^16.4.5",
    "imapflow": "^2.0.2",
    "nodemailer": "^10.0.9"
  },
  "devDependencies": {
    "@types/imapflow": "^1.0.23",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
