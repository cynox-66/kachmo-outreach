# Kachmo Outbound OS — environment variables (server-side only; none of these may be prefixed NEXT_PUBLIC_).
# Copy to .env.local for local development. Never commit real values.

# ── Database (Neon PostgreSQL). Use a Neon BRANCH for development and rehearsals, never the production branch.
DATABASE_URL=

# Applying schema migrations requires naming the target host explicitly (see server/db/migrate.ts).
# KACHMO_MIGRATE_CONFIRM_HOST=

# ── Authentication (Better Auth)
# 32+ random bytes, e.g. `openssl rand -base64 32`. Rotating it signs everyone out.
BETTER_AUTH_SECRET=
# Public base URL of this deployment, e.g. https://os.kachmo.in (http://localhost:3000 locally)
BETTER_AUTH_URL=

# ── Which store is canonical (ADR-009). Production is POST_CUTOVER (see database/CUTOVER_STATE.json).
# Unset means PRE_CUTOVER: the frozen JSON store, which is not deployed.
KACHMO_CUTOVER_PHASE=

# ── First-owner bootstrap (one-time; see os/README.md). Remove after use.
# KACHMO_BOOTSTRAP_OWNER_EMAIL=
# KACHMO_BOOTSTRAP_OWNER_NAME=
